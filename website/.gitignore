# Ruby and Jekyll build state
/.bundle/
/.jekyll-cache/
/.jekyll-metadata
/.ruby-lsp/
/.sass-cache/
/vendor/
/_site/
/_site-*/

# Node dependencies and generated frontend assets
/node_modules/
/.jekyll-obsidian-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test and coverage output
/coverage/
/playwright-report/
/blob-report/
/test-results/
/.vitest/
/.nyc_output/

# Local environment and temporary files
/.env
/.env.*
!/.env.example
/tmp/
/log/

# Obsidian per-device state; stable example-vault settings remain tracked
/docs/.obsidian/workspace.json
/docs/.obsidian/workspace-mobile.json
/docs/.obsidian/cache/
/docs/.obsidian/plugins/
/docs/.trash/
