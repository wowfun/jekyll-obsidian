#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROJECT_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
HOST_DIR=$(CDPATH= cd -- "$PROJECT_DIR/.." && pwd)
export BUNDLE_GEMFILE="$PROJECT_DIR/Gemfile"

origin=${PAGES_ORIGIN:-${JEKYLL_URL:-}}
base_path=""
base_path_is_set=0
destination=_site
build_assets=1
theme=""
source_override=""
example_mode=0

if [ "${PAGES_BASE_PATH+x}" = x ]; then
  base_path=$PAGES_BASE_PATH
  base_path_is_set=1
elif [ "${JEKYLL_BASEURL+x}" = x ]; then
  base_path=$JEKYLL_BASEURL
  base_path_is_set=1
fi

usage() {
  printf '%s\n' "Usage: <site-dir>/bin/build [--url ORIGIN] [--baseurl PATH] [--source PATH | --example] [--theme minimal|docs] [--destination _site[-NAME]] [--skip-assets]"
}

fail() {
  printf '%s\n' "$1" >&2
  exit 1
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --url)
      [ "$#" -ge 2 ] || fail "--url requires a value."
      origin=$2
      shift 2
      ;;
    --baseurl|--base-path)
      [ "$#" -ge 2 ] || fail "$1 requires a value."
      base_path=$2
      base_path_is_set=1
      shift 2
      ;;
    --destination)
      [ "$#" -ge 2 ] || fail "--destination requires a value."
      destination=$2
      shift 2
      ;;
    --theme)
      [ "$#" -ge 2 ] || fail "--theme requires a value."
      case "$2" in
        minimal|docs) theme=$2 ;;
        *) fail "--theme must be one of: minimal, docs." ;;
      esac
      shift 2
      ;;
    --source)
      [ "$#" -ge 2 ] || fail "--source requires a value."
      [ -n "$2" ] || fail "--source requires a non-empty value."
      source_override=$2
      shift 2
      ;;
    --example)
      example_mode=1
      shift
      ;;
    --skip-assets)
      build_assets=0
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      usage >&2
      fail "Unknown option: $1"
      ;;
  esac
done

if [ "$example_mode" -eq 1 ]; then
  [ -z "$source_override" ] || fail "--example cannot be combined with --source."
  source_override=website/docs
fi

case "$destination" in
  _site|_site-[A-Za-z0-9]* ) ;;
  *) fail "--destination must be _site or a top-level _site-NAME directory." ;;
esac
case "$destination" in
  *[!A-Za-z0-9._-]*) fail "--destination contains unsupported characters." ;;
esac
target_destination=$PROJECT_DIR/$destination
if [ -L "$target_destination" ]; then
  fail "--destination must not be a symbolic link."
fi
if [ -e "$target_destination" ] && [ ! -d "$target_destination" ]; then
  fail "--destination must be a directory when it already exists."
fi

assert_local_directory() {
  directory=$1
  label=$2
  case "$directory" in
    "$PROJECT_DIR"/*) ;;
    *) fail "$label must stay inside the site directory." ;;
  esac
  if [ -L "$directory" ]; then
    fail "$label must not be a symbolic link."
  fi
  if [ -e "$directory" ] && [ ! -d "$directory" ]; then
    fail "$label must be a directory."
  fi
}

jekyll_cache=$PROJECT_DIR/.jekyll-cache
application_cache=$PROJECT_DIR/.jekyll-obsidian-cache
assert_local_directory "$jekyll_cache" "Jekyll cache"
assert_local_directory "$application_cache" "Application cache"
mkdir -p "$jekyll_cache" "$application_cache"

host_config=$HOST_DIR/.github/jekyll-obsidian.yml
if [ -L "$HOST_DIR/.github" ] || [ -L "$host_config" ]; then
  fail "host configuration must not use symbolic links."
fi
config_files=$PROJECT_DIR/_config.yml
if [ "$example_mode" -eq 1 ]; then
  example_config=$PROJECT_DIR/scripts/example-config.yml
  [ -f "$example_config" ] && [ ! -L "$example_config" ] || fail "bundled example configuration is missing."
  config_files=$config_files,$example_config
elif [ -e "$host_config" ]; then
  [ -f "$host_config" ] || fail ".github/jekyll-obsidian.yml must be a regular file."
  config_files=$config_files,$host_config
fi

if [ -n "${GITHUB_REPOSITORY:-}" ]; then
  case "$GITHUB_REPOSITORY" in
    */*) ;;
    *) fail "GITHUB_REPOSITORY must have the form owner/repository." ;;
  esac
  owner=${GITHUB_REPOSITORY%%/*}
  repository=${GITHUB_REPOSITORY#*/}
  case "$owner/$repository" in
    /*|*/|*/*/*) fail "GITHUB_REPOSITORY must have the form owner/repository." ;;
  esac

  if [ -z "$origin" ]; then
    origin="https://$owner.github.io"
  fi

  if [ "$base_path_is_set" -eq 0 ]; then
    if [ "$repository" = "$owner.github.io" ]; then
      base_path=""
    else
      base_path="/$repository"
    fi
    base_path_is_set=1
  fi
fi

origin=${origin%/}
if [ -n "$origin" ]; then
  printf '%s' "$origin" | LC_ALL=C grep -Eq '^https?://([A-Za-z0-9][A-Za-z0-9.-]*|\[[0-9A-Fa-f:]+\])(:[0-9]+)?$' ||
    fail "--url must be an HTTP or HTTPS origin without a path, query, or fragment."
fi

if [ -n "$base_path" ]; then
  case "$base_path" in
    /*) ;;
    *) fail "--baseurl must be empty or start with /." ;;
  esac
  case "$base_path" in
    */) base_path=${base_path%/} ;;
  esac
  case "$base_path/" in
    *'/../'*|*'/./'*|*'//'*) fail "--baseurl must be a normalized site path." ;;
  esac
  printf '%s' "$base_path" | LC_ALL=C grep -Eq '^(/[A-Za-z0-9._~!$&()*+,;=:@%-]+)+$' ||
    fail "--baseurl contains unsupported characters."
fi

build_environment=${JEKYLL_ENV:-production}
if [ "$build_environment" = production ] && [ -z "$origin" ]; then
  fail "production builds require --url or PAGES_ORIGIN."
fi

overlay_dir=$(mktemp -d "$application_cache/config.XXXXXX")
overlay=$overlay_dir/config.yml
staging_destination=$(mktemp -d "$application_cache/site-build.XXXXXX")
cleanup() {
  if [ -n "${staging_destination:-}" ] && [ -d "$staging_destination" ]; then
    rm -rf -- "$staging_destination"
  fi
  rm -f -- "$overlay"
  rmdir -- "$overlay_dir"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

yaml_string() {
  escaped=$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')
  printf '"%s"' "$escaped"
}

{
  printf 'source: '
  yaml_string "$PROJECT_DIR"
  printf '\nplugins_dir: '
  yaml_string "_plugins"
  printf '\nlayouts_dir: '
  yaml_string "_layouts"
  printf '\nincludes_dir: '
  yaml_string "_includes"
  printf '\ndata_dir: '
  yaml_string "_data"
  printf '\ncollections_dir: '
  yaml_string ""
  printf '\ncache_dir: '
  yaml_string "$jekyll_cache"
  printf '\nsafe: false'
  printf '\nincremental: false'
  printf '\nstrict_front_matter: true'
  printf '\nurl: '
  yaml_string "$origin"
  printf '\nbaseurl: '
  yaml_string "$base_path"
  printf '\ndisable_disk_cache: true'
  printf '\ndestination: '
  yaml_string "$staging_destination"
  if [ -n "$source_override" ] || [ -n "$theme" ]; then
    printf '\nwebsite:'
    if [ -n "$source_override" ]; then
      printf '\n  source: '
      yaml_string "$source_override"
    fi
    if [ -n "$theme" ]; then
      printf '\n  theme: '
      yaml_string "$theme"
    fi
  fi
  printf '\n'
} > "$overlay"

cd "$PROJECT_DIR"
if [ "$build_assets" -eq 1 ]; then
  npm run build
fi

JEKYLL_ENV=$build_environment bundle exec jekyll build --trace --config "$config_files,$overlay"

if [ "$build_environment" = production ]; then
  "$PROJECT_DIR/scripts/audit-site.sh" "$staging_destination"
  bundle exec ruby "$PROJECT_DIR/scripts/verify-site-urls.rb" "$staging_destination" "$origin" "$base_path"
fi

backup_destination=$application_cache/site-backup-$$
if [ -e "$backup_destination" ] || [ -L "$backup_destination" ]; then
  fail "stale site backup exists: $backup_destination"
fi
had_previous=0
if [ -d "$target_destination" ]; then
  mv -- "$target_destination" "$backup_destination"
  had_previous=1
fi
if mv -- "$staging_destination" "$target_destination"; then
  staging_destination=""
  if [ "$had_previous" -eq 1 ]; then
    rm -rf -- "$backup_destination"
  fi
else
  if [ "$had_previous" -eq 1 ] && [ ! -e "$target_destination" ]; then
    mv -- "$backup_destination" "$target_destination"
  fi
  fail "could not publish the staged site."
fi
