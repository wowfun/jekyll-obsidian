#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
SITE_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd -P)
HOST_DIR=$(CDPATH= cd -- "$SITE_DIR/.." && pwd -P)
CONFIG_PATH=$HOST_DIR/.github/jekyll-obsidian.yml
WORKFLOW_PATH=$HOST_DIR/.github/workflows/pages.yml
CONFIG_TEMPLATE=$SITE_DIR/scripts/templates/host-config.yml
WORKFLOW_TEMPLATE=$SITE_DIR/scripts/templates/pages.yml
CONFIG_START='  # jekyll-obsidian:managed-start'
CONFIG_END='  # jekyll-obsidian:managed-end'
WORKFLOW_MARKER='# Generated by website/bin/integrate. Re-run that command instead of editing this file.'

source_value=""
theme_value=""
source_was_set=0
theme_was_set=0
check_only=0
force_workflow=0
config_tmp=""
workflow_tmp=""

usage() {
  cat <<'USAGE'
Usage: website/bin/integrate [options]

Configure a host repository for GitHub Pages without Ruby or Node.js.

Options:
  --source PATH       Repository-relative content directory (default: docs)
  --theme THEME       minimal or docs (default: minimal)
  --check             Verify generated integration files without changing them
  --force-workflow    Replace an existing unmanaged Pages workflow
  --help, -h          Show this help
USAGE
}

fail() {
  printf '%s\n' "Integration error: $1" >&2
  exit 1
}

fail_unmanaged_config() {
  cat >&2 <<'MESSAGE'
Integration error: .github/jekyll-obsidian.yml is not managed by this command.
Merge this block into a root website mapping, then run the command again:

website:
  # jekyll-obsidian:managed-start
  source: 'docs'
  theme: 'minimal'
  # jekyll-obsidian:managed-end
MESSAGE
  exit 1
}

cleanup() {
  [ -z "$config_tmp" ] || rm -f -- "$config_tmp"
  [ -z "$workflow_tmp" ] || rm -f -- "$workflow_tmp"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

while [ "$#" -gt 0 ]; do
  case "$1" in
    --source)
      [ "$#" -ge 2 ] || fail "--source requires a value."
      source_value=$2
      source_was_set=1
      shift 2
      ;;
    --theme)
      [ "$#" -ge 2 ] || fail "--theme requires a value."
      theme_value=$2
      theme_was_set=1
      shift 2
      ;;
    --check)
      check_only=1
      shift
      ;;
    --force-workflow)
      force_workflow=1
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      usage >&2
      fail "unknown option: $1"
      ;;
  esac
done

[ "${SITE_DIR##*/}" = website ] || fail "the site directory must be named website and live at the host repository root."
[ -f "$CONFIG_TEMPLATE" ] || fail "missing host configuration template: website/scripts/templates/host-config.yml"
[ -f "$WORKFLOW_TEMPLATE" ] || fail "missing Pages workflow template: website/scripts/templates/pages.yml"

if [ "$check_only" -eq 1 ]; then
  [ "$source_was_set" -eq 0 ] || fail "--check cannot be combined with --source."
  [ "$theme_was_set" -eq 0 ] || fail "--check cannot be combined with --theme."
  [ "$force_workflow" -eq 0 ] || fail "--check cannot be combined with --force-workflow."
  [ -f "$CONFIG_PATH" ] || fail "missing .github/jekyll-obsidian.yml; run website/bin/integrate."
  [ -f "$WORKFLOW_PATH" ] || fail "missing .github/workflows/pages.yml; run website/bin/integrate."
fi

assert_not_link() {
  path=$1
  label=$2
  [ ! -L "$path" ] || fail "$label must not be a symbolic link."
}

assert_not_link "$HOST_DIR/.github" ".github"
assert_not_link "$HOST_DIR/.github/workflows" ".github/workflows"
assert_not_link "$CONFIG_PATH" ".github/jekyll-obsidian.yml"
assert_not_link "$WORKFLOW_PATH" ".github/workflows/pages.yml"
[ ! -e "$HOST_DIR/.github" ] || [ -d "$HOST_DIR/.github" ] || fail ".github must be a directory."
[ ! -e "$HOST_DIR/.github/workflows" ] || [ -d "$HOST_DIR/.github/workflows" ] || fail ".github/workflows must be a directory."

managed_value() {
  key=$1
  awk -v start="$CONFIG_START" -v finish="$CONFIG_END" -v key="$key" '
    BEGIN { inside = 0; in_root = 0; found = 0; started = 0; finished = 0; roots = 0; quote = sprintf("%c", 39) }
    $0 ~ /^website:[[:space:]]*$/ {
      roots++
      in_root = 1
      next
    }
    in_root && $0 ~ /^[^[:space:]#]/ { in_root = 0 }
    $0 == start {
      if (started || finished || !in_root) invalid = 1
      started = 1
      inside = 1
      next
    }
    $0 == finish {
      if (!inside || finished || !in_root) invalid = 1
      finished = 1
      inside = 0
      next
    }
    inside {
      prefix = "  " key ": " quote
      if (index($0, prefix) == 1 && substr($0, length($0), 1) == quote) {
        value = substr($0, length(prefix) + 1, length($0) - length(prefix) - 1)
        doubled = quote quote
        gsub(doubled, quote, value)
        print value
        found++
      }
    }
    END { if (invalid || roots != 1 || !started || !finished || inside || found != 1) exit 1 }
  ' "$CONFIG_PATH"
}

if [ -e "$CONFIG_PATH" ]; then
  [ -f "$CONFIG_PATH" ] || fail ".github/jekyll-obsidian.yml must be a regular file."
  website_root_count=$(grep -Ec '^website:[[:space:]]*$' "$CONFIG_PATH" || true)
  [ "$website_root_count" -eq 1 ] || fail_unmanaged_config
  start_count=$(grep -Fxc "$CONFIG_START" "$CONFIG_PATH" || true)
  end_count=$(grep -Fxc "$CONFIG_END" "$CONFIG_PATH" || true)
  if [ "$start_count" -ne 1 ] || [ "$end_count" -ne 1 ]; then
    fail_unmanaged_config
  fi
  current_source=$(managed_value source) || fail "the managed source entry is malformed."
  current_theme=$(managed_value theme) || fail "the managed theme entry is malformed."
  [ "$source_was_set" -eq 1 ] || source_value=$current_source
  [ "$theme_was_set" -eq 1 ] || theme_value=$current_theme
else
  [ "$source_was_set" -eq 1 ] || source_value=docs
  [ "$theme_was_set" -eq 1 ] || theme_value=minimal
fi

source_value=$(printf '%s' "$source_value" | sed 's|\\|/|g')
case "$source_value" in
  ""|.|/*|[A-Za-z]:/*|*//*|*/|*'/./'*|*'/../'*|./*|../*)
    fail "--source must be a normalized repository-relative directory."
    ;;
esac
if printf '%s' "$source_value" | LC_ALL=C grep -q '[[:cntrl:]]'; then
  fail "--source must not contain control characters."
fi
case "$source_value" in
  website/docs) ;;
  website|website/*) fail "--source must not overlap website/ except for the bundled website/docs example." ;;
esac
case "$theme_value" in
  minimal|docs) ;;
  *) fail "--theme must be one of: minimal, docs." ;;
esac

current_path=$HOST_DIR
old_ifs=$IFS
IFS=/
set -f
for segment in $source_value; do
  current_path=$current_path/$segment
  assert_not_link "$current_path" "website.source"
done
set +f
IFS=$old_ifs
[ -d "$current_path" ] || fail "website.source does not exist: $source_value"
resolved_source=$(CDPATH= cd -- "$current_path" && pwd -P)
[ "$resolved_source" = "$HOST_DIR/$source_value" ] || fail "--source casing must match the repository path exactly."

if [ -e "$WORKFLOW_PATH" ]; then
  workflow_first_line=$(sed -n '1p' "$WORKFLOW_PATH")
  if [ "$workflow_first_line" != "$WORKFLOW_MARKER" ]; then
    [ "$force_workflow" -eq 1 ] || fail ".github/workflows/pages.yml is not managed by this command; rerun with --force-workflow to replace it."
  fi
fi

yaml_escape() {
  printf '%s' "$1" | sed "s/'/''/g"
}

glob_escape() {
  printf '%s\n' "$1" | awk '
    {
      result = ""
      for (position = 1; position <= length($0); position++) {
        character = substr($0, position, 1)
        if (character == "*" || character == "?" || character == "+" ||
            character == "[" || character == "]" || character == "!") {
          result = result "\\"
        }
        result = result character
      }
      print result
    }
  '
}

escaped_source=$(yaml_escape "$source_value")
escaped_theme=$(yaml_escape "$theme_value")
source_glob=$(glob_escape "$source_value")/**
escaped_glob=$(yaml_escape "$source_glob")
# awk processes backslashes in -v assignments, so protect the glob escapes until
# they are written into the single-quoted YAML scalar.
escaped_glob_for_awk=$(printf '%s' "$escaped_glob" | sed 's/\\/\\\\/g')

render_config() {
  destination=$1
  if [ -e "$CONFIG_PATH" ]; then
    awk -v start="$CONFIG_START" -v finish="$CONFIG_END" \
      -v source="$escaped_source" -v theme="$escaped_theme" '
      $0 == start {
        print
        print "  source: " sprintf("%c", 39) source sprintf("%c", 39)
        print "  theme: " sprintf("%c", 39) theme sprintf("%c", 39)
        inside = 1
        next
      }
      $0 == finish { inside = 0; print; next }
      !inside { print }
    ' "$CONFIG_PATH" > "$destination"
  else
    awk -v source="$escaped_source" -v theme="$escaped_theme" '
      /__JEKYLL_WEBSITE_SOURCE__/ {
        print "  source: " sprintf("%c", 39) source sprintf("%c", 39)
        next
      }
      /__JEKYLL_WEBSITE_THEME__/ {
        print "  theme: " sprintf("%c", 39) theme sprintf("%c", 39)
        next
      }
      { print }
    ' "$CONFIG_TEMPLATE" > "$destination"
  fi
}

render_workflow() {
  destination=$1
  awk -v glob="$escaped_glob_for_awk" '
    /__JEKYLL_WEBSITE_SOURCE_GLOB__/ {
      print "      - " sprintf("%c", 39) glob sprintf("%c", 39)
      next
    }
    { print }
  ' "$WORKFLOW_TEMPLATE" > "$destination"
}

if [ "$check_only" -eq 1 ]; then
  config_tmp=$(mktemp "${TMPDIR:-/tmp}/jekyll-obsidian-config.XXXXXX")
  workflow_tmp=$(mktemp "${TMPDIR:-/tmp}/jekyll-obsidian-workflow.XXXXXX")
else
  mkdir -p -- "$HOST_DIR/.github/workflows"
  [ -w "$HOST_DIR/.github" ] || fail ".github must be writable."
  [ -w "$HOST_DIR/.github/workflows" ] || fail ".github/workflows must be writable."
  config_tmp=$(mktemp "$HOST_DIR/.github/.jekyll-obsidian.yml.tmp.XXXXXX")
  workflow_tmp=$(mktemp "$HOST_DIR/.github/workflows/.pages.yml.tmp.XXXXXX")
fi
render_config "$config_tmp"
render_workflow "$workflow_tmp"

if [ "$check_only" -eq 1 ]; then
  cmp -s "$config_tmp" "$CONFIG_PATH" || fail ".github/jekyll-obsidian.yml is not normalized; run website/bin/integrate."
  cmp -s "$workflow_tmp" "$WORKFLOW_PATH" || fail ".github/workflows/pages.yml is out of sync; run website/bin/integrate."
  printf '%s\n' "Host integration is valid for $source_value using the $theme_value theme."
  exit 0
fi

config_changed=0
workflow_changed=0
if [ ! -e "$CONFIG_PATH" ] || ! cmp -s "$config_tmp" "$CONFIG_PATH"; then
  config_changed=1
fi
if [ ! -e "$WORKFLOW_PATH" ] || ! cmp -s "$workflow_tmp" "$WORKFLOW_PATH"; then
  workflow_changed=1
fi

if [ "$config_changed" -eq 1 ]; then
  mv -f -- "$config_tmp" "$CONFIG_PATH"
  config_tmp=""
fi
if [ "$workflow_changed" -eq 1 ]; then
  mv -f -- "$workflow_tmp" "$WORKFLOW_PATH"
  workflow_tmp=""
fi

printf '%s\n' "Configured $source_value with the $theme_value theme."
printf '%s\n' "Generated .github/jekyll-obsidian.yml and .github/workflows/pages.yml."
printf '%s\n' "Next: in GitHub, choose Settings > Pages > Build and deployment > Source > GitHub Actions, then commit and push these files."
