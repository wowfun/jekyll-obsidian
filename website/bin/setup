#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROJECT_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
export BUNDLE_GEMFILE="$PROJECT_DIR/Gemfile"

fail() {
  printf '%s\n' "$1" >&2
  exit 1
}

cd "$PROJECT_DIR"

command -v ruby >/dev/null 2>&1 || fail "Ruby 4.0.x is required."
command -v bundle >/dev/null 2>&1 || fail "Bundler is required. Install it with Ruby 4.0.x."
command -v node >/dev/null 2>&1 || fail "Node.js 26.x is required."
command -v npm >/dev/null 2>&1 || fail "npm is required."

ruby_version=$(ruby -e 'print RUBY_VERSION')
node_version=$(node -p 'process.versions.node')

case "$ruby_version" in 4.0.*) ;; *) fail "Expected Ruby 4.0.x, found $ruby_version." ;; esac
case "$node_version" in 26.*) ;; *) fail "Expected Node.js 26.x, found $node_version." ;; esac

bundle config set --local path vendor/bundle
bundle install
npm ci
npm run build

printf '%s\n' "Setup complete. Run <site-dir>/bin/dev to start the local site."
printf '%s\n' "Browser checks are optional locally. Install Chromium with: (cd <site-dir> && npx playwright install chromium)"
