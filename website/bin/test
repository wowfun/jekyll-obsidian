#!/usr/bin/env sh
set -eu
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROJECT_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
export BUNDLE_GEMFILE="$PROJECT_DIR/Gemfile"
cd "$PROJECT_DIR"
pnpm run build
bundle exec ruby scripts/package.rb --skip-assets
bundle exec rake test
pnpm run test:prepared
if [ "${RUN_BROWSER_TESTS:-0}" = 1 ]; then
  pnpm run test:browser:prepared
else
  printf '%s\n' 'Browser tests skipped. Set RUN_BROWSER_TESTS=1 after installing Playwright browsers.'
fi
