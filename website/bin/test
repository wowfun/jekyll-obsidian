#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROJECT_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
export BUNDLE_GEMFILE="$PROJECT_DIR/Gemfile"

cd "$PROJECT_DIR"
test/integration/integrate_contract.sh
test/integration/update_contract.sh
test/integration/build_contract.sh
test/integration/clean_contract.sh
npm run build
bundle exec rake test
npm run test:prepared

if [ "${RUN_BROWSER_TESTS:-0}" = 1 ]; then
  npm run test:browser:prepared
else
  printf '%s\n' "Browser tests skipped. Set RUN_BROWSER_TESTS=1 after installing Playwright browsers."
fi
