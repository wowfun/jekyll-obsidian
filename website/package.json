{
  "name": "jekyll-obsidian",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "description": "Frontend development and browser checks for jekyll-obsidian.",
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "node scripts/build-assets.mjs",
    "clean": "bin/clean",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && pnpm run test:prepared",
    "test:prepared": "pnpm run typecheck && vitest run && node --test tests/node/**/*.test.mjs",
    "test:watch": "vitest",
    "build:browser-sites": "node tests/browser/build-sites.mjs",
    "test:browser": "pnpm run build && pnpm run test:browser:prepared",
    "test:browser:prepared": "pnpm run build:browser-sites && playwright test",
    "test:e2e": "pnpm run test:browser"
  },
  "dependencies": {
    "@mathjax/src": "4.1.3",
    "d3": "7.9.0",
    "mermaid": "12.2.0",
    "minisearch": "7.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "@types/d3": "7.4.3",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.1",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
