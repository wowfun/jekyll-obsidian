{
  "name": "jekyll-obsidian",
  "version": "2026.8.6",
  "private": true,
  "type": "module",
  "description": "Frontend assets and browser checks for the configurable Jekyll Obsidian template.",
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "build": "node scripts/build-assets.mjs",
    "clean": "bin/clean",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && npm run test:prepared",
    "test:prepared": "npm run typecheck && vitest run && node --test tests/node/**/*.test.mjs",
    "test:watch": "vitest",
    "build:browser-sites": "node tests/browser/build-sites.mjs",
    "test:browser": "npm run build && npm run test:browser:prepared",
    "test:browser:prepared": "npm run build:browser-sites && playwright test",
    "test:e2e": "npm run test:browser"
  },
  "dependencies": {
    "d3": "7.9.0",
    "mathjax-full": "3.2.2",
    "mermaid": "11.16.0",
    "minisearch": "7.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@types/d3": "7.4.3",
    "esbuild": "0.28.1",
    "happy-dom": "20.11.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
